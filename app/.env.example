NODE_ENV=development
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent (padrão: info)
LOG_LEVEL=info
OTEL_SERVICE_NAME=oficina-mecanica-customer-auth
OTEL_SERVICE_NAMESPACE=oficina-mecanica
SERVICE_VERSION=dev

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=techchallenge

DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=5000
DATABASE_SSL=false
# PEM da autoridade certificadora esperada. Ausente = autoridades públicas do
# Node. O RDS usa CA privada da Amazon: em produção a cadeia precisa vir daqui
# ou de NODE_EXTRA_CA_CERTS=/var/runtime/ca-cert.pem — ver docs/database.md.
# DATABASE_SSL_CA=

# AWS Secrets Manager. Em produção são obrigatórios, e os fallbacks abaixo são
# ignorados
DATABASE_SECRET_ID=oficina-mecanica/customer-auth/database
CUSTOMER_JWT_PRIVATE_KEY_SECRET_ID=oficina-mecanica/customer-auth/jwt-private-key
# Fallback aceito apenas em development e test.
DATABASE_SECRET={"username":"postgres","password":"postgres"}

# PEM PKCS#8 de teste. Gere o seu com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out key.pem
# CUSTOMER_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

CUSTOMER_JWT_ISSUER=oficina-customer-auth
CUSTOMER_JWT_AUDIENCE=oficina-api
CUSTOMER_JWT_TTL_SECONDS=3600
CUSTOMER_JWT_KEY_ID=customer-auth-2026-08
