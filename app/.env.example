NODE_ENV=development
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
OTEL_SERVICE_NAME=oficina-mecanica-lambda-customer-auth
OTEL_SERVICE_NAMESPACE=oficina-mecanica
SERVICE_VERSION=dev

# Internal routes of Identity and work-order. The local stub (npm run stub)
# serves both on port 4010
IDENTITY_INTERNAL_URL=http://localhost:4010
WORK_ORDER_INTERNAL_URL=http://localhost:4010
# With the local stacks of both services running:
# IDENTITY_INTERNAL_URL=http://localhost:3001
# WORK_ORDER_INTERNAL_URL=http://localhost:3000

# AWS Secrets Manager. Required in production, where the fallback below is
# ignored
CUSTOMER_JWT_PRIVATE_KEY_SECRET_ID=oficina-mecanica/customer-auth/jwt-private-key

# Fallback accepted only in development and test: a test PKCS#8 PEM. Generate yours with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out key.pem
# CUSTOMER_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

CUSTOMER_JWT_ISSUER=oficina-customer-auth
CUSTOMER_JWT_AUDIENCE=oficina-api
CUSTOMER_JWT_TTL_SECONDS=3600
CUSTOMER_JWT_KEY_ID=customer-auth-2026-08
