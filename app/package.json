{
  "name": "oficina-mecanica-customer-auth",
  "version": "0.0.1",
  "description": "Função serverless para autenticação de clientes",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "invoke": "tsx --env-file-if-exists=.env scripts/invoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./jest.e2e.config.ts --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^5.10.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.907.0",
    "@eslint/js": "^9.18.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/aws-lambda": "^8.10.158",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.25.12",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
