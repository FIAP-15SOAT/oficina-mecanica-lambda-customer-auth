# All values below have a versioned default in `variables.tf`. This file
# exists for when a local run needs to diverge — the pipeline does not
# use it.

# aws_region  = "us-east-1"
# environment = "prod-simulated"

# Function name. It is a contract with the API Gateway: changing it here requires changing it there.
# function_name = "lbd-oficina-mecanica-customer-auth"

# Pre-existing execution role of the lab. Read through a data source.
# lambda_execution_role_name = "LabRole"

# Concurrency reservation. Use -1 when the account quota does not leave at least
# one hundred unreserved executions. Never zero: a zero reservation turns the function off.
# lambda_reserved_concurrency = 10

# Injected by the delivery on each apply.
# service_version = "dev"

# Collection layer. The credential comes from the production environment vault.
# enable_telemetry_collection = false
# telemetry_api_key           = ""
